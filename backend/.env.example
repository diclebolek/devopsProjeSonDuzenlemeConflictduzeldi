# Django Secret Key (Herhangi bir rastgele metin olabilir)
DJANGO_SECRET_KEY=local-dev-secret-key-12345-abcdefgh
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Azure PostgreSQL Bilgileri (Arkadaslariniz burayi kendi bilgileriyle veya paylasilan bilgilerle dolduracak)
POSTGRES_HOST=dicle-backend-db.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=db_manager
