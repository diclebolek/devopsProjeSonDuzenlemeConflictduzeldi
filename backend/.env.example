POSTGRES_SSLMODE=require

# CORS & JWT
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
JWT_SIGNING_KEY=local-dev-jwt-signing-key-minimum-32-chars-long
